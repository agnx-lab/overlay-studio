{
  "id": "overlay-studio",
  "name": "Overlay Studio",
  "version": "1.2.0",
  "description": "Agnx 外置：Overlay Studio —— 给口播视频加动效层的可视化工作台（Vite + React 纯前端）。注意：上游为源码公开(source available)许可，非 OSI 开源，禁止转售与商业再分发；本机 8131 端口 Guest 嵌入。",
  "engines": {
    "agnx": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "icon": "./.agnx/assets/icon.svg",
  "iconDark": "./.agnx/assets/icon-dark.svg",
  "platforms": {
    "desktop": "supported",
    "web": "supported",
    "mobile": "unsupported"
  },
  "guest": {
    "kind": "web",
    "auth": "none",
    "preferStrategy": "direct-iframe"
  },
  "sidecar": {
    "supervised": true,
    "ensureTool": ".agnx/tools/ensure-overlay-studio.mjs",
    "stateFile": "overlay-studio.json",
    "defaultPort": 8131,
    "label": "Overlay Studio 服务"
  },
  "contributes": {
    "commands": [
      {
        "id": "overlay-studio.open",
        "title": "Overlay Studio"
      }
    ],
    "panels": [
      {
        "id": "overlay-studio.main",
        "title": "Overlay Studio"
      }
    ]
  }
}